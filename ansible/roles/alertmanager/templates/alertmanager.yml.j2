# alertmanager.yml — generated by Ansible
# Mediterranean Ops Fortress — Alert routing configuration

global:
  resolve_timeout: 5m
  smtp_smarthost:  "{{ smtp_host | default('localhost:587') }}"
  smtp_from:       "{{ alert_from_email | default('alerts@med-ops-fortress.local') }}"

route:
  group_by:        ["alertname", "job", "severity"]
  group_wait:      30s
  group_interval:  5m
  repeat_interval: 4h
  receiver:        default

  routes:
    - match:
        severity: critical
      receiver: critical
      continue: true

    - match:
        severity: pipeline
      receiver: pipeline_team

receivers:
  - name: default
    webhook_configs:
      - url: "{{ webhook_url | default('http://localhost:5001/alerts') }}"
        send_resolved: true

  - name: critical
    webhook_configs:
      - url: "{{ critical_webhook_url | default('http://localhost:5001/critical') }}"
        send_resolved: true

  - name: pipeline_team
    webhook_configs:
      - url: "{{ pipeline_webhook_url | default('http://localhost:5001/pipeline') }}"
        send_resolved: true

inhibit_rules:
  - source_match:
      severity: critical
    target_match:
      severity: warning
    equal: ["alertname", "job"]
