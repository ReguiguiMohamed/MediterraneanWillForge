# ── Copernicus / CAMS API ──────────────────────────────────────────────────────
CAMS_API_URL=https://ads.atmosphere.copernicus.eu/api/v2
CAMS_API_KEY=your_cams_api_key_here

# ── EEA AirBase / Discomap API ────────────────────────────────────────────────
EEA_API_URL=https://discomap.eea.europa.eu/map/fme/airqualityUTD.htm
EEA_COUNTRY_CODE=TN

# ── MinIO (local lakehouse storage) ───────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# ── Delta Lake / Iceberg ───────────────────────────────────────────────────────
LAKEHOUSE_FORMAT=delta
LAKEHOUSE_BASE_PATH=s3a://bronze

# ── Prometheus push gateway ───────────────────────────────────────────────────
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# ── Pipeline metadata ─────────────────────────────────────────────────────────
PIPELINE_ENV=local
PIPELINE_REGION=TN-MED
LOG_LEVEL=INFO
