# Public data APIs
# Open-Meteo Air Quality API and OpenAQ v2 are queried without API keys.
# Their base URLs are defined in the ingestor modules.

# MinIO local lakehouse storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# Delta Lake
LAKEHOUSE_FORMAT=delta
LAKEHOUSE_BASE_PATH=s3a://bronze

# Prometheus Pushgateway
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# Pipeline metadata
PIPELINE_ENV=local
PIPELINE_REGION=MED
LOG_LEVEL=INFO

# Grafana
GRAFANA_ADMIN_PASSWORD=fortress
