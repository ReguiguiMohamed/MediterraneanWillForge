{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat",       "name": "Stat",        "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge",      "name": "Gauge",       "version": "" }
  ],
  "title": "Mediterranean Ops — Pipeline Observability",
  "uid": "med-ops-pipeline-obs",
  "description": "Real-time observability for the Mediterranean air quality data pipeline. Bronze → Silver → Gold stages, per-source row counts, stage durations, and data freshness.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-14d", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "tags": ["med-ops", "pipeline", "data-engineering"],
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "Current Run Status",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Bronze — Open-Meteo rows",
      "description": "Rows written to Bronze in the most recent pipeline run (openmeteo source).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "pipeline_ingested_rows{layer=\"bronze\", source=\"openmeteo\"}",
          "legendFormat": "openmeteo",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "green",  "value": 10   }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Bronze — OpenAQ rows",
      "description": "Rows written to Bronze in the most recent pipeline run (openaq source).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "pipeline_ingested_rows{layer=\"bronze\", source=\"openaq\"}",
          "legendFormat": "openaq",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "green",  "value": 5    }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Silver rows (last run)",
      "description": "Rows written to Silver after cleaning, enrichment, and WHO flagging.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "pipeline_ingested_rows{layer=\"silver\"}",
          "legendFormat": "silver",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "green",  "value": 10   }
            ]
          }
        }
      }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Gold rows (last run)",
      "description": "Total rows across daily_country_summary + wildfire_risk_index marts.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "pipeline_ingested_rows{layer=\"gold\"}",
          "legendFormat": "gold",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 1    },
              { "color": "green",  "value": 100  }
            ]
          }
        }
      }
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Pipeline age",
      "description": "Time elapsed since the last successful Bronze run. Healthy if < 25h (daily cron at 06:00 UTC).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "time() - pipeline_last_successful_run_timestamp{layer=\"bronze\"}",
          "legendFormat": "age",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null   },
              { "color": "yellow", "value": 86400  },
              { "color": "red",    "value": 90000  }
            ]
          }
        }
      }
    },

    {
      "id": 10,
      "type": "row",
      "title": "Stage Durations",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },

    {
      "id": 11,
      "type": "stat",
      "title": "Bronze Open-Meteo duration",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 3, "w": 6, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "pipeline_duration_seconds{stage=\"bronze_openmeteo\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null  },
              { "color": "yellow", "value": 120   },
              { "color": "red",    "value": 300   }
            ]
          }
        }
      }
    },

    {
      "id": 12,
      "type": "stat",
      "title": "Bronze OpenAQ duration",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 3, "w": 6, "x": 6, "y": 6 },
      "targets": [
        {
          "expr": "pipeline_duration_seconds{stage=\"bronze_openaq\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null  },
              { "color": "yellow", "value": 1200  },
              { "color": "red",    "value": 2400  }
            ]
          }
        }
      }
    },

    {
      "id": 13,
      "type": "stat",
      "title": "Silver transform duration",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 3, "w": 6, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "pipeline_duration_seconds{stage=\"silver_transform\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 60   },
              { "color": "red",    "value": 180  }
            ]
          }
        }
      }
    },

    {
      "id": 14,
      "type": "stat",
      "title": "Gold mart duration",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 3, "w": 6, "x": 18, "y": 6 },
      "targets": [
        {
          "expr": "pipeline_duration_seconds{stage=\"gold_mart\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 60   },
              { "color": "red",    "value": 180  }
            ]
          }
        }
      }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Historical Trends (14-day)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "Rows ingested per source — daily",
      "description": "Bronze row count per source over the retention window. Gaps indicate skipped or failed runs.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "pipeline_ingested_rows{layer=\"bronze\", source=\"openmeteo\"}",
          "legendFormat": "bronze / openmeteo",
          "refId": "A"
        },
        {
          "expr": "pipeline_ingested_rows{layer=\"bronze\", source=\"openaq\"}",
          "legendFormat": "bronze / openaq",
          "refId": "B"
        },
        {
          "expr": "pipeline_ingested_rows{layer=\"silver\"}",
          "legendFormat": "silver (total)",
          "refId": "C"
        },
        {
          "expr": "pipeline_ingested_rows{layer=\"gold\"}",
          "legendFormat": "gold (total)",
          "refId": "D"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "always"
          }
        }
      }
    },

    {
      "id": 22,
      "type": "timeseries",
      "title": "Stage duration — daily",
      "description": "Wall-clock seconds per pipeline stage. Spikes in bronze_openaq indicate rate limiting.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "expr": "pipeline_duration_seconds{stage=\"bronze_openmeteo\"}",
          "legendFormat": "bronze / openmeteo",
          "refId": "A"
        },
        {
          "expr": "pipeline_duration_seconds{stage=\"bronze_openaq\"}",
          "legendFormat": "bronze / openaq",
          "refId": "B"
        },
        {
          "expr": "pipeline_duration_seconds{stage=\"silver_transform\"}",
          "legendFormat": "silver",
          "refId": "C"
        },
        {
          "expr": "pipeline_duration_seconds{stage=\"gold_mart\"}",
          "legendFormat": "gold",
          "refId": "D"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "always"
          }
        }
      }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Data Quality",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },

    {
      "id": 31,
      "type": "gauge",
      "title": "Quality check failures (total)",
      "description": "Cumulative pipeline_quality_check_failures_total across all checks and layers. Should stay at 0.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 19 },
      "targets": [
        {
          "expr": "sum(pipeline_quality_check_failures_total) or vector(0)",
          "legendFormat": "failures",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1    }
            ]
          }
        }
      }
    },

    {
      "id": 32,
      "type": "timeseries",
      "title": "Quality failures over time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 19 },
      "targets": [
        {
          "expr": "pipeline_quality_check_failures_total",
          "legendFormat": "{{check_name}} / {{layer}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 20 },
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    }

  ]
}
