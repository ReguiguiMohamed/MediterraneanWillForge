# alertmanager.yml — generated by Ansible
# Mediterranean Ops Fortress — Alert routing configuration

global:
  resolve_timeout: 5m

route:
  group_by:        ["alertname", "layer", "severity", "environment"]
  group_wait:      30s
  group_interval:  5m
  repeat_interval: 4h
  receiver:        infra_ops

  routes:
    - matchers:
        - severity = critical
      receiver: infra_critical
      group_wait:      10s
      group_interval:  2m
      repeat_interval: 1h

    - matchers:
        - severity = pipeline
      receiver: pipeline_ops
      group_wait:      1m
      group_interval:  5m
      repeat_interval: 2h

    - matchers:
        - severity = warning
        - layer =~ "bronze|silver|gold"
      receiver: pipeline_ops
      group_wait:      2m
      group_interval:  10m
      repeat_interval: 4h

receivers:
  - name: infra_ops
    slack_configs:
      - api_url:        "{{ slack_webhook_url }}"
        channel:        "{{ slack_channel_ops | default('#med-ops-alerts') }}"
        send_resolved:  true
        title:          '[{{ "{{" }} .Status | toUpper {{ "}}" }}{{ "{{" }} if eq .Status "firing" {{ "}}" }}:{{ "{{" }} .Alerts.Firing | len {{ "}}" }}{{ "{{" }} end {{ "}}" }}] {{ "{{" }} .GroupLabels.alertname {{ "}}" }}'
        text:           '{{ "{{" }} range .Alerts {{ "}}" }}*{{ "{{" }} .Labels.severity | toUpper {{ "}}" }}* {{ "{{" }} .Annotations.summary {{ "}}" }}\n{{ "{{" }} end {{ "}}" }}'

  - name: infra_critical
    slack_configs:
      - api_url:        "{{ slack_webhook_url }}"
        channel:        "{{ slack_channel_critical | default('#med-ops-critical') }}"
        send_resolved:  true
        title:          '[CRITICAL] {{ "{{" }} .GroupLabels.alertname {{ "}}" }}'
        text:           '{{ "{{" }} range .Alerts {{ "}}" }}{{ "{{" }} .Annotations.summary {{ "}}" }}\n{{ "{{" }} end {{ "}}" }}'

  - name: pipeline_ops
    slack_configs:
      - api_url:        "{{ slack_webhook_url }}"
        channel:        "{{ slack_channel_pipeline | default('#med-ops-pipeline') }}"
        send_resolved:  true
        title:          '[{{ "{{" }} .Status | toUpper {{ "}}" }}] Pipeline — {{ "{{" }} .GroupLabels.alertname {{ "}}" }}'
        text:           '{{ "{{" }} range .Alerts {{ "}}" }}{{ "{{" }} .Annotations.summary {{ "}}" }}\n{{ "{{" }} end {{ "}}" }}'

inhibit_rules:
  - source_matchers:
      - alertname = MinIODown
      - severity = critical
    target_matchers:
      - layer =~ "bronze|silver|gold"

  - source_matchers:
      - alertname = ContainerDown
      - severity = critical
    target_matchers:
      - severity = warning
      - alertname =~ "HighCPUUsage|HighMemoryUsage"
    equal: [name]

  - source_matchers:
      - severity = critical
    target_matchers:
      - severity = warning
    equal: [alertname]
