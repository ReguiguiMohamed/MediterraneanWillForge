# terraform/environments/cloud/terraform.tfvars.example
# ──────────────────────────────────────────────────────
# Copy to terraform.tfvars and fill in your OCI values.
# Never commit terraform.tfvars — it contains secrets.
#
# How to get these values:
#   1. tenancy_ocid   → OCI Console → Profile (top-right) → Tenancy
#   2. user_ocid      → OCI Console → Profile → User Settings
#   3. fingerprint    → OCI Console → User Settings → API Keys → add key → copy fingerprint
#   4. private_key_path → local path to the .pem you downloaded when adding the API key
#   5. compartment_id → use tenancy_ocid for root compartment (free tier default)
#   6. ssh_authorized_keys → contents of your ~/.ssh/id_ed25519.pub (or id_rsa.pub)

tenancy_ocid     = "ocid1.tenancy.oc1..example"
user_ocid        = "ocid1.user.oc1..example"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "eu-paris-1"
compartment_id   = "ocid1.tenancy.oc1..example"

environment  = "prod"
project_name = "med-ops-fortress"

ssh_authorized_keys = "ssh-ed25519 AAAA... your-email@example.com"

instance_ocpus      = 4
instance_memory_gbs = 24

lakehouse_buckets = {
  bronze = "bronze"
  silver = "silver"
  gold   = "gold"
}
