{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Mediterranean Ops Fortress — Data Pipeline Health",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Pipeline Freshness",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null   },
              { "color": "yellow", "value": 86400  },
              { "color": "red",    "value": 90000  }
            ]
          },
          "unit": "s",
          "mappings": []
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Bronze — Open-Meteo Age",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "time() - pipeline_last_successful_run_timestamp{layer=\"bronze\",source=\"openmeteo\"}",
          "legendFormat": "OpenMeteo"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null   },
              { "color": "yellow", "value": 86400  },
              { "color": "red",    "value": 90000  }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Bronze — OpenAQ Age",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "time() - pipeline_last_successful_run_timestamp{layer=\"bronze\",source=\"openaq\"}",
          "legendFormat": "OpenAQ"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null   },
              { "color": "yellow", "value": 90000  },
              { "color": "red",    "value": 93600  }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Silver Age",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "time() - pipeline_last_successful_run_timestamp{layer=\"silver\"}",
          "legendFormat": "Silver"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null   },
              { "color": "yellow", "value": 93600  },
              { "color": "red",    "value": 97200  }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Gold Age",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "time() - pipeline_last_successful_run_timestamp{layer=\"gold\"}",
          "legendFormat": "Gold"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Row Counts & Throughput",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Ingested Rows by Source",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "pipeline_ingested_rows{layer=\"bronze\", source=\"openmeteo\"}",
          "legendFormat": "Bronze / OpenMeteo"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "pipeline_ingested_rows{layer=\"bronze\", source=\"openaq\"}",
          "legendFormat": "Bronze / OpenAQ"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "pipeline_ingested_rows{layer=\"silver\", source=\"openmeteo\"}",
          "legendFormat": "Silver / OpenMeteo"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "pipeline_ingested_rows{layer=\"silver\", source=\"openaq\"}",
          "legendFormat": "Silver / OpenAQ"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "pipeline_ingested_rows{layer=\"gold\"}",
          "legendFormat": "Gold"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "Pipeline Stage Duration",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "pipeline_duration_seconds{stage=\"bronze_openmeteo\"}",
          "legendFormat": "Bronze OpenMeteo"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "pipeline_duration_seconds{stage=\"bronze_openaq\"}",
          "legendFormat": "Bronze OpenAQ"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "pipeline_duration_seconds{stage=\"silver_transform\"}",
          "legendFormat": "Silver transform"
        },
        {
          "datasource": { "type": "prometheus" },
          "expr": "pipeline_duration_seconds{stage=\"gold_mart\"}",
          "legendFormat": "Gold mart"
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Data Quality",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1    }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 15 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Total Quality Failures",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum(pipeline_quality_check_failures_total) or vector(0)",
          "legendFormat": "Failures"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null   },
              { "color": "yellow", "value": 90000  },
              { "color": "red",    "value": 93600  }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 15 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "title": "Quality Runner Age",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "max(time() - pipeline_last_quality_run_timestamp)",
          "legendFormat": "Quality age"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 9,
      "title": "Quality Failures by Check & Layer",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "increase(pipeline_quality_check_failures_total[1h])",
          "legendFormat": "{{ check_name }} / {{ layer }}"
        }
      ]
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 19 },
      "id": 10,
      "title": "Quality Failures — Bronze vs Silver (rate 1h)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus" },
          "expr": "sum by(layer) (increase(pipeline_quality_check_failures_total[1h]))",
          "legendFormat": "{{ layer }}"
        }
      ]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mediterranean", "pipeline", "data-engineering"],
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Pipeline Health",
  "uid": "med-ops-pipeline",
  "version": 2
}
