# MediterraneanWillForge line-ending policy
# Enforce LF everywhere. No CRLF noise on Windows checkouts.

* text=auto eol=lf

# Explicitly text files
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.sql       text eol=lf
*.txt       text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
.env*       text eol=lf

# Binary — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.parquet binary
# Generated report artifacts — keep original line endings
docs/pipeline_report.html  binary
docs/pipeline_report.ipynb text eol=lf
