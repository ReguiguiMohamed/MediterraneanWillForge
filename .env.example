# Public data APIs
# Open-Meteo Air Quality API requires no credentials.
# OpenAQ v3 works without a key but enforces anonymous-tier rate limits.
# Register free at https://explore.openaq.org/register to get a key.
OPENAQ_API_KEY=

# Object storage — Backblaze B2 (S3-compatible)
# Create an Application Key at: https://secure.backblaze.com/app_keys.htm
# Endpoint format: https://s3.<region>.backblazeb2.com
MINIO_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
MINIO_ACCESS_KEY=your-b2-key-id
MINIO_SECRET_KEY=your-b2-application-key
MINIO_BUCKET_BRONZE=med-ops-mohamed-bronze
MINIO_BUCKET_SILVER=med-ops-mohamed-silver
MINIO_BUCKET_GOLD=med-ops-mohamed-gold
AWS_REGION=eu-central-003

# dbt / DuckDB httpfs — host only (no scheme, no port for HTTPS)
MINIO_HOST=s3.eu-central-003.backblazeb2.com
S3_USE_SSL=true

# Delta Lake
LAKEHOUSE_FORMAT=delta

# Prometheus Pushgateway
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# Pipeline metadata
PIPELINE_ENV=prod
PIPELINE_REGION=MED
LOG_LEVEL=INFO

# Grafana (local self-hosted stack)
GRAFANA_ADMIN_PASSWORD=fortress

# Grafana Cloud — Prometheus remote_write (optional)
# Get values from: mohamedwillforge.grafana.net → Administration → Cloud Portal
# → Prometheus card → Details. Token: Security → Access Policies (metrics:write scope).
GRAFANA_REMOTE_WRITE_URL=https://prometheus-prod-58-prod-eu-central-0.grafana.net/api/prom/push
GRAFANA_METRICS_ID=3166110
GRAFANA_TOKEN=
