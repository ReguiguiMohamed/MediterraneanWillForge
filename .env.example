# Optional API keys
OPENAQ_API_KEY=
WAQI_API_KEY=

# Local MinIO. Hosted B2 values are supplied by GitHub Actions.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold
AWS_REGION=us-east-1

# dbt / DuckDB httpfs
MINIO_HOST=localhost:9000
S3_USE_SSL=false
DBT_DUCKDB_PATH=./data/dbt/med_ops_dbt.duckdb

# Pipeline
LAKEHOUSE_FORMAT=delta
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091
PIPELINE_ENV=local
PIPELINE_REGION=MED
LOG_LEVEL=INFO

# Grafana Cloud remote_write (optional and best-effort)
GRAFANA_REMOTE_WRITE_URL=
GRAFANA_METRICS_ID=
GRAFANA_TOKEN=
