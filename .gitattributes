# Mediterranean Ops Fortress — Git line-ending policy
# Enforce LF everywhere. No CRLF noise on Windows checkouts.

* text=auto eol=lf

# Explicitly text files
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.tf        text eol=lf
*.tfvars    text eol=lf
*.sh        text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.sql       text eol=lf
*.ini       text eol=lf
*.txt       text eol=lf
*.j2        text eol=lf
Makefile    text eol=lf
Vagrantfile text eol=lf
Dockerfile  text eol=lf
.env*       text eol=lf

# Binary — never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.parquet binary
